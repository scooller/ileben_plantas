# Configuracion del plugin iLeben Plantas
# Copia este archivo a .env y ajusta los valores

# Endpoint completo de la API de plantas (obligatorio para sincronizar)
# Ejemplo: https://tu-dominio.com/api/v1/plants
ENDPOINT_API=https://tu-dominio.com/api/v1/plants

# ID del proyecto a filtrar (opcional)
# Si se configura, solo sincronizará plantas de ese proyecto específico
# Ejemplo: PROYECTO_ID=29
PROYECTO_ID=

# Token de autorizacion Bearer (opcional, la API publica no lo requiere)
ENDPOINT_TOKEN=

# URL global de cotizacion (opcional)
# Se usa como fallback en el boton "Cotizar" cuando la planta no tiene cotizacion_url propia
COTIZA_URL=

# Timeout de peticiones HTTP en segundos (minimo: 5, maximo: 120)
TIMEOUT=30

# Habilitar sincronizacion automatica por cron cada hora
# Valores validos: true, 1, yes, on (activado) | false, 0, no, off (desactivado)
CRON=true
